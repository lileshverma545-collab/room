{
  "rules": {
    "rooms": {
      ".read":  "auth != null && auth.uid === 'PASTE_ADMIN_UID_HERE'",
      ".write": "auth != null && auth.uid === 'PASTE_ADMIN_UID_HERE'",
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === 'PASTE_ADMIN_UID_HERE' || (!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid || data.child('guest').val() === auth.uid || (data.exists() && !data.child('guest').exists() && newData.child('guest').val() === auth.uid))",
        ".validate": "newData.hasChildren(['host','board','turn','status'])",
        "board":  { ".validate": "newData.isString() && newData.val().length === 9" },
        "turn":   { ".validate": "newData.val() === 'X' || newData.val() === 'O'" },
        "status": { ".validate": "newData.val() === 'waiting' || newData.val() === 'playing' || newData.val() === 'finished'" },
        "hostName":  { ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 14)" },
        "guestName": { ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 14)" }
      }
    }
  }
}
